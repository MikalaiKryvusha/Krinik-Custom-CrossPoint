+ public:
+  void begin() {}
+  bool present() const { return true; }
+  bool hasColorTemperature() const { return true; }
+  void setBrightness(uint8_t p) {
+    physicalOutput = p;
+    rawLevel = -1;
+  }
+  void setBrightnessLevel(uint8_t p) {
+    rawLevel = p;
+    physicalOutput = p ? 100 : 0;
+  }
