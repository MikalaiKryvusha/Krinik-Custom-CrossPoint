+#pragma once
+#include <cstdint>
+inline int panelWidth = 480, clearValue = 0, shownValue = 0;
+inline bool panelInverted = false;
+class RenderLock {};
+class GfxRenderer {
+ public:
+  void clearScreen(uint8_t p) { clearValue = p; }
